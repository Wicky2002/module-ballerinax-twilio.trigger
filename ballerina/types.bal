# Configuration for the webhook listener, including the secret used to verify incoming requests.
public type ListenerConfig record {
    # The secret used to verify incoming webhook signatures.
    string webhookSecret?;
    # Configurable value referenced by the webhook signature verification DSL (`$config('webhookBaseUrl')`).
    string webhookBaseUrl = "";
};

public type CallStatusEventWrapper record {|
    # Your Twilio account ID. It is 34 characters long, and always starts with the letters AC.
    string AccountSid?;
    # The version of the Twilio API used to handle this call.
    string ApiVersion?;
    # A unique identifier for this call, generated by Twilio.
    string CallSid?;
    # A descriptive status for the call.
    string CallStatus?;
    # A token string needed to invoke a forwarded call.
    string CallToken?;
    # Called number.
    string Called?;
    # The city that called.
    string CalledCity?;
    # The country that called.
    string CalledCountry?;
    # The state that called.
    string CalledState?;
    # The zip code of the called party.
    string CalledZip?;
    # The number of the caller.
    string Caller?;
    # The city of the caller.
    string CallerCity?;
    # The country of the caller.
    string CallerCountry?;
    # The state of the caller.
    string CallerState?;
    # The zip code of the caller.
    string CallerZip?;
    # A string describing the direction of the call.
    string Direction?;
    # The phone number or client identifier of the party that initiated the call.
    string From?;
    # The city of the caller.
    string FromCity?;
    # The country of the caller.
    string FromCountry?;
    # The state or province of the caller.
    string FromState?;
    # The postal code of the caller.
    string FromZip?;
    # The identity token which contains the information needs for authentication and verification of calls.
    string StirPassportToken?;
    # The value that verifies the authenticity of the caller ID on an incoming call.
    string StirVerstat?;
    # The phone number or client identifier of the called party.
    string To?;
    # The city of the called party.
    string ToCity?;
    # The country of the called party.
    string ToCountry?;
    # The state or province of the called party.
    string ToState?;
    # The postal code of the called party.
    string ToZip?;
    # The unique id of the Recording from this call.
    string RecordingSid?;
    # The URL of the phone call's recorded audio.
    string RecordingUrl?;
    # The duration in seconds of the just-completed call.
    string CallDuration?;
    # The duration of the recorded audio (in seconds).
    string RecordingDuration?;
    # The duration in minutes of the just-completed call. Only present in the completed event.
    string Duration?;
    # The SIP response code for the call. Only present in terminal events.
    string SipResponseCode?;
    # When the event fired, as UTC in RFC 2822 format.
    string Timestamp?;
    # Always `call-progress-events` on status callbacks.
    string CallbackSource?;
    # The order in which the events were fired, starting from 0.
    string SequenceNumber?;
    # The STIR/SHAKEN attestation level, A, B or C.
    string StirStatus?;
    # The SID of the call that created this one, for a call created by a `<Dial>`.
    string ParentCallSid?;
    # The number the call was forwarded from, when the carrier provides it.
    string ForwardedFrom?;
    # The caller's name, for an inbound call with Caller ID Lookup enabled.
    string CallerName?;
    json...;
|};

public type SmsStatusChangeEventWrapper record {|
    # A 34 character unique identifier for the message.
    string MessageSid?;
    # Same value as MessageSid. Deprecated and included for backward compatibility.
    string SmsSid?;
    # The 34 character id of the Account this message is associated with.
    string AccountSid?;
    # The 34 character id of the Messaging Service associated with the message.
    string MessagingServiceSid?;
    # The phone number or Channel address that sent this message.
    string From?;
    # The phone number or Channel address of the recipient.
    string To?;
    # The text body of the message. Up to 1600 characters long.
    string Body?;
    # The number of media items associated with your message.
    string NumMedia?;
    # The number of media items associated with a "Click to WhatsApp" advertisement.
    string ReferralNumMedia?;
    # The city of the sender.
    string FromCity?;
    # The state or province of the sender.
    string FromState?;
    # The status of the message.
    string SmsStatus?;
    # The postal code of the called sender.
    string FromZip?;
    # The country of the called sender.
    string FromCountry?;
    # The city of the recipient.
    string ToCity?;
    # The state or province of the recipient.
    string ToState?;
    # The postal code of the recipient.
    string ToZip?;
    # The country of the recipient.
    string ToCountry?;
    # The status of the message.
    string MessageStatus?;
    # A unique identifier for this message, generated by Twilio.
    string SmsMessageSid?;
    # Number of SMS messages it took to deliver the body of the message.
    string NumSegments?;
    # The version of the Twilio API used to handle this message.
    string ApiVersion?;
    # The error code when `MessageStatus` is `failed` or `undelivered`.
    string ErrorCode?;
    # The carrier's delivery receipt Done Date, `YYMMDDhhmm`, for delivered or undelivered SMS and MMS.
    string RawDlrDoneDate?;
    # The channel installation SID, for WhatsApp, RCS and other channels.
    string ChannelInstallSid?;
    # The error message returned by the messaging channel when delivery failed.
    string ChannelStatusMessage?;
    # The channel prefix, such as `whatsapp`, for non-SMS channels.
    string ChannelPrefix?;
    # Information about post-delivery events, for channels that report them.
    string EventType?;
    json...;
|};
